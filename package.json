{
  "name": "matrukavach-health-erp",
  "private": true,
  "version": "1.0.0",
  "description": "MatruKavach rural maternal healthcare ERP",
  "scripts": {
    "install:all": "npm install --prefix backend && npm install --prefix frontend",
    "seed": "npm run seed --prefix backend",
    "seed:clean": "npm run seed:clean --prefix backend",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev": "concurrently -n api,web -c blue,green \"npm run dev:backend\" \"npm run dev:frontend\"",
    "start": "npm start --prefix backend"
  },
  "devDependencies": {
    "concurrently": "^9.0.1"
  }
}
